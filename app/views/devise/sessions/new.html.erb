<script src="https://cdn.tailwindcss.com"></script>

<div class="max-w-md mx-auto px-4 py-16">
  <div class="bg-white border border-gray-200 rounded-2xl p-8 shadow-sm">
    
    <div class="text-center mb-8">
      <h2 class="text-2xl font-bold text-gray-900">Hesabınıza Giriş Yapın</h2>
      <p class="text-sm text-gray-500 mt-1">Geliştirici paneline erişmek için bilgilerinizi girin.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-6" }) do |f| %>
      
      <div>
        <%= f.label :email, "E-posta Adresi", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "ornek@gmail.com",
            class: "w-full px-4 py-3 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-gray-900 transition" %>
      </div>

      <div>
        <%= f.label :password, "Şifre", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••",
            class: "w-full px-4 py-3 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-gray-900 transition" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center">
          <%= f.check_box :remember_me, class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" %>
          <%= f.label :remember_me, "Beni Hatırla", class: "ml-2 block text-sm text-gray-700 font-medium" %>
        </div>
      <% end %>

      <div>
        <%= f.submit "Giriş Yap", 
            class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-xl shadow-sm transition duration-200 cursor-pointer text-center block" %>
      </div>
    <% end %>

    <div class="mt-6 pt-4 border-t border-gray-100 text-center text-sm space-y-2 text-gray-500">
      <%= render "devise/shared/links" %>
    </div>

  </div>
</div>
