<p style="color: green"><%= notice %></p>
<p style="color: red"><%= alert %></p>

<div style="max-width: 600px; margin: 40px auto; padding: 20px; border: 1px solid #e0e0e0; border-radius: 8px; font-family: sans-serif;">
  
  <%# Makale Başlığı %>
  <h1 style="font-size: 28px; margin-bottom: 10px; color: #333;"><%= @article.title %></h1>
  
  <%# Yeni Eklediğimiz Kullanıcı Adı Bilgisi %>
  <p style="font-size: 13px; color: #777; margin-bottom: 20px; border-bottom: 1px solid #eee; padding-bottom: 10px;">
    ✍️ Yazar: <strong>@<%= @article.user&.username || "anonim" %></strong>
  </p>

  <%# Makale İçeriği %>
  <div style="font-size: 16px; line-height: 1.6; color: #555; margin-bottom: 30px;">
    <%= simple_format(@article.body) %>
  </div>

  <%# Alt Linkler %>
  <div style="display: flex; gap: 15px; font-size: 14px; border-top: 1px solid #eee; padding-top: 15px;">
    <%= link_to "← Anasayfaya Dön", articles_path, style: "color: #555; text-decoration: none; font-weight: bold;" %>
    
    <%# Eğer giriş yapmış kullanıcı makalenin sahibiyse düzenleme yetkisi ver %>
    <% if user_signed_in? && @article.user == current_user %>
      | <%= link_to "Düzenle", edit_article_path(@article), style: "color: #2b6cb0; text-decoration: none;" %>
    <% end %>
  </div>

</div>
