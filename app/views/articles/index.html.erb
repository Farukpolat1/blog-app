<div class="container my-5" style="font-family: sans-serif;">
  
  <%# Bildirim Mesajları %>
  <% if notice.present? %>
    <div class="alert alert-success alert-dismissible fade show" role="alert"><%= notice %></div>
  <% end %>
  <% if alert.present? %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert"><%= alert %></div>
  <% end %>

  <%# Üst Menü / Giriş Yapan Kullanıcı Alanı %>
  <div class="d-flex justify-content-between align-items-center p-3 mb-4 bg-light border rounded shadow-sm">
    <% if user_signed_in? %>
      <div>
        <span class="text-secondary">Hoş geldin,</span> 
        <span class="badge bg-primary fs-6">@<%= current_user.username %></span>
        <small class="text-muted ms-2">(<%= current_user.email %>)</small>
      </div>
      <%= link_to "Çıkış Yap", destroy_user_session_path, data: { turbo: false }, class: "btn btn-outline-danger btn-sm fw-bold" %>
    <% else %>
      <div>
        <%= link_to "Giriş Yap", new_user_session_path, class: "btn btn-primary btn-sm me-2" %>
        <%= link_to "Kayıt Ol", new_user_registration_path, class: "btn btn-outline-primary btn-sm" %>
      </div>
    <% end %>
  </div>

  <%# Başlık ve Yeni Makale Butonu %>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-5 fw-bold text-dark">Makaleler</h1>
    <%= link_to "+ Yeni Makale Oluştur", new_article_path, class: "btn btn-success px-4 py-2 shadow-sm fw-bold" %>
  </div>

  <%# Makale Kartları (Grid Sistemi) %>
  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <% @articles.each do |article| %>
      <div class="col">
        <div class="card h-100 shadow-sm border-0 bg-white" style="border-radius: 12px; transition: transform 0.2s;">
          <div class="card-body d-flex flex-column">
            
            <%# Başlık %>
            <h5 class="card-title fw-bold text-dark mb-2"><%= article.title %></h5>
            
            <%# Yazar Bilgisi %>
            <h6 class="card-subtitle mb-3 text-muted" style="font-size: 13px;">
              ✍️ @<%= article.user&.username || "anonim" %>
            </h6>
            
            <%# İçerik Özeti (İlk 120 karakter) %>
            <p class="card-text text-secondary text-truncate-3 flex-grow-1" style="font-size: 14px; line-height: 1.5;">
              <%= truncate(article.body, length: 120) %>
            </p>
            
            <%# Butonlar Eylemleri %>
            <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
              <%= link_to "Detayı Gör →", article_path(article), class: "btn btn-link p-0 text-decoration-none fw-bold" %>
              
              <%# Sadece sahibi düzenleyip silebilir %>
              <% if user_signed_in? && article.user == current_user %>
                <div class="btn-group">
                  <%= link_to "Düzenle", edit_article_path(article), class: "btn btn-outline-secondary btn-sm" %>
                  <%= link_to "Sil", article_path(article), data: { turbo_method: :delete, turbo_confirm: "Emin misiniz?" }, class: "btn btn-outline-danger btn-sm" %>
                </div>
              <% end %>
            </div>

          </div>
        </div>
      </div>
    <% end %>
  </div>

</div>