<div class="max-w-3xl mx-auto px-4 py-12">
  
  <div class="mb-6">
    <%= link_to "← Günlüğe Geri Dön", posts_path, class: "text-sm font-medium text-emerald-600 hover:text-emerald-800 transition" %>
  </div>

  <article class="bg-white border border-gray-200 rounded-2xl p-8 shadow-sm mb-8">
    <h1 class="text-3xl font-extrabold text-gray-900 mb-6 border-b pb-4"><%= @post.title %></h1>
    <div class="text-gray-700 leading-relaxed text-lg space-y-4 whitespace-pre-line">
      <%= @post.body %>
    </div>

    <div class="flex justify-end gap-3 mt-8 pt-4 border-t border-gray-100">
      <%= link_to "Yazıyı Düzenle", edit_post_path(@post), class: "bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium px-4 py-2 rounded-lg text-sm transition" %>
      <%= link_to "Yazıyı Sil", post_path(@post), data: { turbo_method: :delete, turbo_confirm: "Bu yazıyı silmek istediğinize emin misiniz?" }, class: "bg-red-50 hover:bg-red-100 text-red-600 font-medium px-4 py-2 rounded-lg text-sm transition" %>
    </div>
  </article>

  <div class="bg-white border border-gray-200 rounded-2xl p-8 shadow-sm">
    <h2 class="text-xl font-bold text-gray-900 mb-6 flex items-center">
      💬 Yorumlar (<%= @post.comments.count %>)
    </h2>

    <div class="space-y-4 mb-8">
      <% @post.comments.each do |comment| %>
        <% if comment.persisted? %>
          <div class="bg-gray-50 border border-gray-100 rounded-xl p-4">
            <div class="flex justify-between items-center mb-2">
              <span class="font-semibold text-sm text-gray-800">Anonim Geliştirici</span>
              <%= link_to "Sil", post_comment_path(@post, comment), data: { turbo_method: :delete, turbo_confirm: "Yorumu silmek istiyor musunuz?" }, class: "text-xs text-red-500 hover:underline" %>
            </div>
            <p class="text-gray-600 text-sm leading-relaxed"><%= comment.body %></p>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="border-t border-gray-100 pt-6">
      <h3 class="text-sm font-bold text-gray-700 mb-3">Fikrini Paylaş</h3>
      <%= form_with model: [ @post, @post.comments.build ], class: "space-y-4" do |form| %>
        <div>
          <%= form.text_area :body, rows: 3, placeholder: "Bu yazı hakkında ne düşünüyorsun?", class: "w-full px-4 py-3 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 text-sm text-gray-900 transition" %>
        </div>
        <div>
          <%= form.submit "Yorum Yap", class: "bg-gray-900 hover:bg-gray-800 text-white font-semibold text-sm px-4 py-2 rounded-lg shadow-sm transition cursor-pointer" %>
        </div>
      <% end %>
    </div>

  </div>

</div>


