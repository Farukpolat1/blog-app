<div class="max-w-4xl mx-auto px-4 py-8">

  <div class="flex justify-between items-center mb-10 border-b pb-4">
    <div>
      <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Geliştirici Günlüğü</h1>
      <p class="text-sm text-gray-500 mt-1">Teknoloji dünyasından güncel yazılar ve deneyimler.</p>
    </div>
    <%= link_to "Yeni Yazı Paylaş", new_post_path, class: "bg-emerald-600 hover:bg-emerald-700 text-white font-medium px-4 py-2 rounded-lg shadow-sm transition" %>
  </div>

  <div class="space-y-6">
    <% @posts.each do |post| %>
      <article class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm hover:shadow-md transition flex flex-col justify-between">
        <div>
          <h2 class="text-2xl font-bold text-gray-800 hover:text-emerald-600 mb-3 transition">
            <%= link_to post.title, post_path(post) %>
          </h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            <%= truncate(post.body, length: 150) %>
          </p>
        </div>

        <div class="flex justify-between items-center pt-4 border-t border-gray-50 text-sm">
          <span class="text-gray-400 flex items-center">
            📝 <%= post.comments.count %> Yorum
          </span>
          <%= link_to "Okumaya Devam Et →", post_path(post), class: "font-semibold text-emerald-600 hover:text-emerald-800" %>
        </div>
      </article>
    <% end %>
  </div>

</div>