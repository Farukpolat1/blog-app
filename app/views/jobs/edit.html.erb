<script src="https://cdn.tailwindcss.com"></script>

<div class="max-w-xl mx-auto px-4 py-12">

  <div class="mb-6">
    <%= link_to "← Listeye Geri Dön", jobs_path, class: "text-sm font-medium text-gray-500 hover:text-gray-700 transition" %>
  </div>

  <div class="bg-white border border-gray-200 rounded-2xl p-8 shadow-sm">
    
    <div class="mb-8 border-b pb-4">
      <h1 class="text-2xl font-bold text-gray-900">Yeni İş İlanı Oluştur</h1>
      <p class="text-sm text-gray-500 mt-1">Lütfen ilan bilgilerini eksiksiz doldurunuz.</p>
    </div>

    <%= form_with model: @job, class: "space-y-6" do |form| %>
      
      <div>
        <%= form.label :title, "İş Başlığı", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.text_field :title, placeholder: "Örn: Senior Ruby Developer", 
            class: "w-full px-4 py-3 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-gray-900 transition" %>
      </div>

      <div>
        <%= form.label :company, "Şirket Adı", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.text_field :company, placeholder: "Örn: Harika Teknoloji A.Ş.", 
            class: "w-full px-4 py-3 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-gray-900 transition" %>
      </div>

      <div>
        <%= form.label :url, "İlan Başvuru Linki (URL)", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <%= form.text_field :url, placeholder: "Örn: https://sirket.com/kariyer", 
            class: "w-full px-4 py-3 border border-gray-300 rounded-xl shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-gray-900 transition" %>
      </div>

      <div class="pt-4">
        <%= form.submit "İlanı Yayınla", 
            class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-xl shadow-sm transition duration-200 cursor-pointer text-center block" %>
      </div>

    <% end %>

  </div>
</div>
